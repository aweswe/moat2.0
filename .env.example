# ============================================
# AgentTrace 2.0 — Environment Variables
# ============================================

# Supabase (Auth + Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Cloudflare R2 (File Storage)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=agenttrace-traces
R2_PUBLIC_URL=https://your-r2-domain.r2.dev

# Groq (AFE LLM)
GROQ_API_KEY=your_groq_key

# Brevo (Email Notifications)
BREVO_API_KEY=your_brevo_key
BREVO_SENDER_EMAIL=noreply@agenttrace.dev
BREVO_SENDER_NAME=AgentTrace

# Worker
WORKER_POLL_INTERVAL=2000
